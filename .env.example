APP_NAME=nrth
# Local/dev template. Production: APP_ENV=production, APP_DEBUG=false. See docs/SELF_HOST.md (Multi-tenant hardening).
APP_ENV=local
# Empty here is for the template only. Generate a unique key: php artisan key:generate. Never reuse an example key in production.
APP_KEY=
# Must be false on any instance reachable beyond a trusted machine. Leaks env, SQL, and stack traces.
APP_DEBUG=true
APP_URL=http://localhost:8000
# Install fallback / break-glass. Operators can also set Settings → Instance → Timezone.
APP_TIMEZONE=UTC
APP_VERSION=0.1.19 # x-release-please-version

# Compare version.txt to the latest GitHub Release and show “update available” in the UI.
# Disable on air-gapped hosts. Default is on. PHPUnit forces this off.
# NRTH_RELEASE_CHECK=false
# NRTH_GITHUB_REPOSITORY=mortolian/nrth
# NRTH_RELEASE_CHECK_TTL=21600

# Optional break-glass: comma-separated emails that can manage instance backups even without
# the database operator flag. Prefer Settings → Instance after first login; first user is
# promoted automatically. For existing installs: php artisan nrth:promote-first-operator
# NRTH_OPERATOR_EMAILS=you@example.com

# Safety guard: blocks destructive reset commands like `php artisan migrate:fresh`,
# `migrate:refresh`, and `db:wipe` outside APP_ENV=testing. Set to 1 only when you
# intentionally want to wipe the current database.
# NRTH_ALLOW_DESTRUCTIVE_DATABASE_RESET=0

# HTTPS — production requires TLS (APP_ALLOW_HTTP=false). Contributor `--dev` and trusted-LAN `--lan` installs may set true.
APP_FORCE_HTTPS=false
APP_ALLOW_HTTP=true
TRUSTED_PROXIES=*
# SESSION_SECURE_COOKIE defaults to true when APP_ALLOW_HTTP=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (local) ---
# SQLite (simplest local dev)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# PostgreSQL with Docker Compose (single compose.yaml):
# - Run `php artisan` on your Mac/PC: use 127.0.0.1 and FORWARD_DB_PORT (default 5432).
#   The app, worker, and scheduler containers override DB_HOST to `postgres` automatically.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nrthapp
# DB_USERNAME=dbuser
# Example password for local Compose only. Production must use a unique secret — not this value.
# DB_PASSWORD=dbpassword

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave unset for host-only cookies (required for LAN IP access).
# SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Spatie media (invoice PDFs, receipts). Private local disk — not the public /storage symlink.
MEDIA_DISK=local

# Redis + queues (use with Horizon / Docker worker)
# QUEUE_CONNECTION=redis
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — default `log` writes to storage/logs (no inbox). For Docker Compose / Sail with the
# optional `dev` profile, use Mailpit with MAIL_MAILER=smtp, MAIL_HOST=mailpit, MAIL_PORT=1025
# and open http://localhost:8025 to read mail. Self-hosted installs can set these env vars or
# configure SMTP in the UI (Settings → Instance → Outbound email); UI overrides .env when enabled.
# Use a From address on a domain your SMTP provider has verified (not example.com). Instance SMTP
# From also applies to Spatie backup status emails; recipients default to instance operators
# (optional override: BACKUP_NOTIFICATION_EMAIL). See docs/SELF_HOST.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# BACKUP_NOTIFICATION_EMAIL=you@your-domain.com
# Optional AES password for instance backup zips. Keep a copy off-host; restore cannot unzip without it.
# BACKUP_ARCHIVE_PASSWORD=

# --- Optional S3 object storage (only if FILESYSTEM_DISK=s3) ---
# Uploads default to the local disk (storage/app/private). Set FILESYSTEM_DISK=s3 and
# configure these keys to use AWS S3, Cloudflare R2, or another S3-compatible provider.
# Instance backup offsite destinations are configured in the UI (Backups & exports) and
# do not require these env vars unless you also use S3 as FILESYSTEM_DISK.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_SERVICE=app
APP_USER=root
APP_PORT=8000
VITE_PORT=5173

# Optional Compose profiles:
# - `dev` starts the Vite HMR service on :5173 for contributor workflows
# - `proxy` starts Caddy for TLS on 443 → Octane HTTP on app:8000
# Enable one or both with a comma-separated list, then `./scripts/compose.sh up -d`
# COMPOSE_PROFILES=dev
# COMPOSE_PROFILES=proxy
# COMPOSE_PROFILES=dev,proxy
# CADDY_SITE=books.example.com
# CADDY_TLS=off
# For LAN IP access use self-signed certs:
# CADDY_SITE=192.168.1.204
# CADDY_TLS=internal
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# When COMPOSE_PROFILES includes `dev`, the Docker Compose / Sail `vite` service publishes
# VITE_PORT (default 5173) and sets sensible server/HMR defaults. Override only if the
# browser cannot load HMR:
# VITE_DEV_SERVER_HOST=0.0.0.0
# VITE_DEV_SERVER_PORT=5173
# VITE_DEV_SERVER_HMR_HOST=localhost
# VITE_DEV_SERVER_HMR_PORT=5173
# VITE_DEV_SERVER_USE_POLLING=true

# Stripe (Laravel Cashier)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayFast live vs sandbox. Production must stay false (or unset). true only when testing against sandbox.payfast.co.za — sandbox ITNs can mark invoices paid.
PAYFAST_SANDBOX=false

# Optional server-wide fallback for AI features (prefer Company settings → AI).
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1

# Docker Compose notes:
# - Single compose file: compose.yaml
# - Start stack: docker compose up -d --build
# - Sail: ./vendor/bin/sail up -d
# - Containers read this `.env` for credentials, but `compose.yaml` overrides in-network
#   hostnames for app/horizon/scheduler where required: DB_HOST=postgres, REDIS_HOST=redis
# - Postgres, Redis, and Mailpit host ports bind to 127.0.0.1 by default for safer self-hosting.
# - Source is bind-mounted into the app container; `vendor` and `node_modules` live in named volumes
#   (populated on first start via entrypoint, or run `sail composer install` / `sail npm ci`).
# - The `vite` service is behind the optional `dev` Compose profile so self-hosted stacks do not
#   expose HMR by default. Enable it explicitly for contributor workflows.
# - With the `dev` profile enabled, Vite HMR updates Vue/JS/CSS; Vite "refresh" reloads the browser
#   when PHP routes/app/config/views/lang change; Octane runs with `--watch --poll` so PHP edits apply
#   without restarting the container. Horizon may need `sail restart horizon` after you change queued
#   jobs or listeners.
# - For host `php artisan`, set REDIS_HOST / MAIL_HOST to 127.0.0.1 with the
#   forwarded ports (FORWARD_*), or run commands inside the app container: `sail artisan ...`
