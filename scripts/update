#!/usr/bin/env bash
#
# Pull latest code and apply updates inside the Docker Compose stack.
#
# Reliability over speed: every update refreshes Laravel caches, rebuilds Vite
# assets, restarts Octane, then verifies git HEAD and a critical route.
#
# Data safety: does NOT remove Docker volumes, run migrate:fresh, or rotate
# database passwords. Migrations are incremental. `git reset --hard` only
# affects tracked files in this clone (not Postgres, Redis, or storage volumes).
#
# Usage:
#   ./scripts/update                 # full update (recommended)
#   ./scripts/update production      # same + app:update maintenance path
#   ./scripts/update dev             # migrate/queues only; still rebuilds assets + route cache
#
# Environment:
#   SKIP_GIT=1          Skip git pull (CI already updated the tree)
#   SKIP_ASSETS=1       Skip npm ci / npm run build (not recommended on servers)
#   GIT_BRANCH=master   Branch to pull (default: master)
#   COMPOSE=...         Override compose command (default: scripts/compose.sh)

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

GIT_BRANCH="${GIT_BRANCH:-master}"
COMPOSE="${COMPOSE:-$ROOT_DIR/scripts/compose.sh}"
SKIP_ASSETS="${SKIP_ASSETS:-0}"

hash_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

read_app_env() {
    if [[ ! -f .env ]]; then
        echo ""
        return
    fi
    grep -E '^APP_ENV=' .env 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" || true
}

resolve_mode() {
    local arg="${1:-}"
    case "$arg" in
        production|prod)
            echo production
            return
            ;;
        dev|development|local)
            echo dev
            return
            ;;
        "")
            ;;
        *)
            echo "error: unknown mode '${arg}' (use production, dev, or omit for full update)" >&2
            exit 1
            ;;
    esac

    # Default: full production-style update. --lan installs use APP_ENV=local but
    # still need route/config cache + asset rebuild on every deploy.
    local app_env
    app_env="$(read_app_env)"
    if [[ "$app_env" == "local" || "$app_env" == "development" ]]; then
        echo full
    elif [[ "$app_env" == "production" ]]; then
        echo production
    else
        echo full
    fi
}

MODE="$(resolve_mode "${1:-}")"

if [[ ! -f compose.yaml ]]; then
    echo "compose.yaml not found. Run this script from the project root."
    exit 1
fi

if [[ "${SKIP_GIT:-0}" != "1" ]] && [[ -d .git ]] && [[ "$(id -u)" -ne 0 ]]; then
    git_owner="$(stat -c '%U' .git 2>/dev/null || stat -f '%Su' .git)"
    current_user="$(id -un)"
    if [[ "$git_owner" == "root" && "$git_owner" != "$current_user" ]]; then
        echo "error: ${ROOT_DIR} is owned by root (install was run with sudo)." >&2
        echo "Fix: sudo chown -R ${current_user}:${current_user} ${ROOT_DIR}" >&2
        exit 1
    fi
fi

BEFORE_COMMIT=""
if [[ -d .git ]]; then
    BEFORE_COMMIT="$(git rev-parse --short HEAD 2>/dev/null || true)"
fi

if [[ "${SKIP_GIT:-0}" != "1" ]]; then
    if [[ -d .git ]] && { ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; }; then
        echo "warning: uncommitted changes in ${ROOT_DIR} will be discarded by git reset --hard"
        echo "         (Docker volumes and database data are not affected)"
    fi
    echo "==> Pulling latest from origin/${GIT_BRANCH} (git reset --hard — code tree only)"
    git fetch origin "${GIT_BRANCH}"
    git reset --hard "origin/${GIT_BRANCH}"
fi

AFTER_COMMIT="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
AFTER_SHORT="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
AFTER_SUBJECT="$(git log -1 --pretty=%s 2>/dev/null || echo '')"
REMOTE_COMMIT="$(git rev-parse "origin/${GIT_BRANCH}" 2>/dev/null || echo '')"

if [[ -n "$REMOTE_COMMIT" && "$AFTER_COMMIT" != "$REMOTE_COMMIT" ]]; then
    echo "error: HEAD (${AFTER_SHORT}) does not match origin/${GIT_BRANCH} ($(git rev-parse --short "$REMOTE_COMMIT"))." >&2
    exit 1
fi

echo "==> Code: ${AFTER_SHORT} — ${AFTER_SUBJECT}"
if [[ -n "$BEFORE_COMMIT" && "$BEFORE_COMMIT" != "$AFTER_SHORT" ]]; then
    echo "    (was ${BEFORE_COMMIT})"
fi

echo "==> Ensuring stack is up (applies compose/.env changes; volumes preserved)"
$COMPOSE up -d

run_app() {
    $COMPOSE exec -T app "$@"
}

disable_vite_dev_server() {
    echo "==> Serving built frontend assets (stopping Vite dev server)"
    $COMPOSE stop vite 2>/dev/null || true
    rm -f "$ROOT_DIR/public/hot"
}

STATE_DIR="$ROOT_DIR/storage/framework"
mkdir -p "$STATE_DIR"
COMPOSER_HASH_FILE="$STATE_DIR/.deploy-composer-hash"
NPM_LOCK_HASH_FILE="$STATE_DIR/.deploy-npm-hash"

CURRENT_COMPOSER="$(hash_file composer.lock)"
if [[ ! -f "$COMPOSER_HASH_FILE" ]] || [[ "$(cat "$COMPOSER_HASH_FILE")" != "$CURRENT_COMPOSER" ]]; then
    echo "==> composer.lock changed — installing PHP dependencies"
    run_app composer install --no-interaction --prefer-dist
    echo "$CURRENT_COMPOSER" > "$COMPOSER_HASH_FILE"
else
    echo "==> composer.lock unchanged — skipping composer install"
fi

BUILT_ASSETS=0
if [[ "$SKIP_ASSETS" == "1" ]]; then
    echo "==> SKIP_ASSETS=1 — skipping npm install/build"
else
    CURRENT_NPM_LOCK="$(hash_file package-lock.json)"
    if [[ ! -f "$NPM_LOCK_HASH_FILE" ]] || [[ "$(cat "$NPM_LOCK_HASH_FILE")" != "$CURRENT_NPM_LOCK" ]]; then
        echo "==> package-lock.json changed — installing npm dependencies"
        run_app npm ci --no-audit --no-fund
        echo "$CURRENT_NPM_LOCK" > "$NPM_LOCK_HASH_FILE"
    else
        echo "==> package-lock.json unchanged — skipping npm ci"
    fi

    echo "==> Building frontend assets (npm run build)"
    run_app npm run build
    BUILT_ASSETS=1
    rm -f "$STATE_DIR/.deploy-assets-hash" 2>/dev/null || true
fi

if ! run_app test -f public/build/manifest.json 2>/dev/null; then
    echo "error: public/build/manifest.json missing after update. Frontend assets were not built." >&2
    exit 1
fi

if [[ "$MODE" != "dev" ]]; then
    disable_vite_dev_server
fi

refresh_caches() {
    echo "==> Refreshing Laravel config / route / view caches"
    run_app php artisan config:clear --no-interaction
    run_app php artisan route:clear --no-interaction
    run_app php artisan view:clear --no-interaction
    run_app php artisan config:cache --no-interaction
    run_app php artisan route:cache --no-interaction
    run_app php artisan view:cache --no-interaction
}

if [[ "$MODE" == "production" ]]; then
    echo "==> Running production update (maintenance mode, migrate, caches, workers)"
    run_app php artisan app:update
else
    echo "==> Running update (migrate + queue restart + caches) [mode=${MODE}]"
    run_app php artisan migrate --force --no-interaction
    run_app php artisan nrth:promote-first-operator
    run_app php artisan queue:restart
    run_app php artisan horizon:terminate 2>/dev/null || true
    $COMPOSE restart worker 2>/dev/null || true
    refresh_caches
fi

echo "==> Restarting app (Octane picks up code and environment changes)"
$COMPOSE restart app

echo "==> Verifying deploy"
VERIFY_OK=1
if ! run_app php artisan route:list --name=expenses.parse-receipt --json 2>/dev/null | grep -q parse-receipt; then
    # Fallback without --json for older artisan output
    if ! run_app php artisan route:list --name=expenses.parse-receipt 2>/dev/null | grep -q parse-receipt; then
        echo "    FAIL: route expenses.parse-receipt is missing"
        VERIFY_OK=0
    else
        echo "    OK: route expenses.parse-receipt"
    fi
else
    echo "    OK: route expenses.parse-receipt"
fi

if run_app test -f public/build/manifest.json 2>/dev/null; then
    echo "    OK: Vite manifest present"
else
    echo "    FAIL: Vite manifest missing"
    VERIFY_OK=0
fi

if [[ "$MODE" != "dev" ]]; then
    if run_app test -f public/hot 2>/dev/null; then
        echo "    FAIL: stale Vite hot file still present"
        VERIFY_OK=0
    else
        echo "    OK: Vite hot file removed"
    fi
fi

echo ""
echo "Update finished ($(date -u +"%Y-%m-%d %H:%M:%S UTC"))."
echo "  Mode: ${MODE} (APP_ENV=$(read_app_env))"
echo "  Commit: ${AFTER_SHORT} — ${AFTER_SUBJECT}"
echo "  Matches origin/${GIT_BRANCH}: yes"
echo "  Assets rebuilt: $([[ "$BUILT_ASSETS" -eq 1 ]] && echo yes || echo no)"
echo "  Data: volumes and database preserved; pending migrations applied only"

if [[ "$VERIFY_OK" -ne 1 ]]; then
    echo "" >&2
    echo "error: deploy verification failed — see FAIL lines above." >&2
    exit 1
fi

echo "  Verification: passed"
